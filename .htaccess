<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to hidden files and folders.
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # Prevent requests from being rewritten repeatedly.
    RewriteRule ^public/ - [L]

    # Route requests through Laravel's public directory.
    RewriteRule ^(.*)$ public/$1 [L]

</IfModule>

# Prevent direct web access to sensitive Laravel files.

<FilesMatch "^(artisan|\.env._|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.._)$">
Require all denied
</FilesMatch>

# Prevent direct access to internal application directories.

RedirectMatch 403 ^/(app|bootstrap|config|database|resources|routes|tests|vendor|node_modules)(/|$)
